{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src",
    "App.tsx"
  ],
  "entryPointStrategy": "expand",
  "out": "../docs/.typedoc/html-mobile",
  "name": "sKirana mobile app",
  "readme": "none",
  "includeVersion": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "sort": [
    "source-order"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "json": "../docs/.typedoc/mobile.json"
}
