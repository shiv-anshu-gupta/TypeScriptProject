{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src"
  ],
  "entryPointStrategy": "expand",
  "out": "../docs/.typedoc/html-server",
  "name": "sKirana server",
  "readme": "none",
  "includeVersion": true,
  "excludePrivate": false,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "sort": [
    "source-order"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "json": "../docs/.typedoc/server.json"
}
