# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase service-account private key (a real secret — upload it via
# `eas credentials`, never commit it). google-services.json is NOT secret
# and MUST stay tracked, or EAS builds won't find it.
*service-account*.json
*-firebase-adminsdk-*.json

# EAS credentials export — contains the keystore + its passwords. Secret.
credentials.json
credentials/
upload_certificate.pem
