+  /**
+   * sKirana patch: draws the notification as an image strip only (no title/text in the
+   * shade), using layouts the app's config plugin writes into res/layout. The library
+   * can't see the app's R class, so ids are looked up by name. Returns false (and
+   * leaves the builder untouched) if anything is missing, so the caller can fall back.
+   */
+  private fun applySkiranaBanner(builder: NotificationCompat.Builder, bitmap: Bitmap): Boolean {
+    return try {
+      val res = context.resources
+      val pkg = context.packageName
+      val collapsedLayout = res.getIdentifier("skirana_notification_banner", "layout", pkg)
+      val expandedLayout = res.getIdentifier("skirana_notification_banner_big", "layout", pkg)
+      val imageId = res.getIdentifier("skirana_banner_image", "id", pkg)
+      if (collapsedLayout == 0 || expandedLayout == 0 || imageId == 0) {
+        Log.w("expo-notifications", "sKirana banner layouts not found; showing picture style.")
+        return false
+      }
+      val image = skiranaScaledBitmap(bitmap)
+      val collapsed = RemoteViews(pkg, collapsedLayout).apply { setImageViewBitmap(imageId, image) }
+      val expanded = RemoteViews(pkg, expandedLayout).apply { setImageViewBitmap(imageId, image) }
+      builder.setLargeIcon(null as Bitmap?)
+      builder.setStyle(NotificationCompat.DecoratedCustomViewStyle())
+      builder.setCustomContentView(collapsed)
+      builder.setCustomBigContentView(expanded)
+      true
+    } catch (e: Exception) {
+      Log.e("expo-notifications", "Could not build sKirana banner notification.", e)
+      false
+    }
+  }
+
+  /** Fits the bitmap inside 1080x1080 so the RemoteViews parcel stays small. */
+  private fun skiranaScaledBitmap(bitmap: Bitmap): Bitmap {
+    val maxSide = 1080
+    val width = bitmap.width
+    val height = bitmap.height
+    if (width <= maxSide && height <= maxSide) return bitmap
+    val scale = min(maxSide.toDouble() / width, maxSide.toDouble() / height)
+    val newWidth = max(1, (width * scale).toInt())
+    val newHeight = max(1, (height * scale).toInt())
+    return Bitmap.createScaledBitmap(bitmap, newWidth, newHeight, true)
+  }
