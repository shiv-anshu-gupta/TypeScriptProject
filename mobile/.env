# Backend API base URL.
# Using the deployed backend so the app works on a physical phone via Expo Go.
# For local dev against your machine, use your LAN IP, e.g. http://192.168.1.5:5000
# (localhost/127.0.0.1 will NOT work from a phone).
EXPO_PUBLIC_BACKEND_URL=https://type-script-project-jtdk.vercel.app

# Clerk publishable key - the PRODUCTION instance (clerk.skirana.com).
# Builds AND `eas update` both bundle this value, so it must stay pk_live.
# To develop against the test instance, put the pk_test key in .env.local
# (gitignored), which overrides this file locally.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc2tpcmFuYS5jb20k
